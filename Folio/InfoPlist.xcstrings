    "NSCalendarsFullAccessUsageDescription" : {
      "comment" : "Privacy - Calendars Full Access Usage Description",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Folio liest deine Kalender, um Lernzeit um deinen Unterricht und deine Termine herum zu planen. Es ändert sie nie."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folio reads your calendars to plan study time around your classes and events. It never changes them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Folio lee tus calendarios para planificar el estudio en función de tus clases y eventos. Nunca los cambia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Folio lit vos calendriers pour planifier vos révisions autour de vos cours et événements. Il ne les modifie jamais."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Folio 会读取你的日历，围绕你的课程和日程安排学习时间。它从不更改你的日历。"
          }
        }
      }
    },
    "NSHumanReadableCopyright" : {
      "comment" : "Copyright (human-readable)",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
