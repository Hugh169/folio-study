    },
    "NSRemindersFullAccessUsageDescription" : {
      "comment" : "Privacy - Reminders Full Access Usage Description",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Folio fügt deine Leistungsüberprüfungen einer Folio-Liste in Erinnerungen hinzu, mit Hinweisen vor dem Abgabetermin, und markiert eine als abgegeben, wenn du sie dort abhakst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folio adds your assessments to a Folio list in Reminders, with alerts before they're due, and marks one submitted when you tick it off there."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Folio añade tus evaluaciones a una lista Folio en Recordatorios, con avisos antes de la fecha de entrega, y marca una como entregada cuando la marcas allí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Folio ajoute vos évaluations à une liste Folio dans Rappels, avec des alertes avant l’échéance, et en marque une comme rendue quand vous la cochez là-bas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Folio 会把你的考核添加到“提醒事项”中的 Folio 列表，并在截止前提醒你；你在那里勾选完成后，这里也会标记为已提交。"
          }
        }
      }
    }
  },
  "version" : "1.0"
