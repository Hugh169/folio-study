    "Files Folio isn't sure about, and tasks it finds in your files, wait here for you." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dateien, bei denen Folio unsicher ist, und Aufgaben, die es in deinen Dateien findet, warten hier auf dich."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Los archivos de los que Folio no está seguro y las tareas que encuentra en tus archivos te esperan aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les fichiers dont Folio n’est pas sûr et les évaluations qu’il trouve dans vos fichiers vous attendent ici."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Folio 拿不准的文件，以及它在你的文件中找到的任务，都会在这里等你处理。"
          }
        }
      }
    },
    "Files Folio sorts appear here." : {
      "localizations" : {
        "de" : {
