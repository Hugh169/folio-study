    "Plan My Week puts sessions in these times, around your classes, events and exams. Work for each assessment is spread over the weeks before it's due." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "„Meine Woche planen“ legt Lerneinheiten in diese Zeiten, um Unterricht, Termine und Prüfungen herum. Die Arbeit für jede Leistungsüberprüfung wird auf die Wochen vor dem Termin verteilt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Planificar mi semana coloca las sesiones en estos horarios, alrededor de tus clases, eventos y exámenes. El trabajo de cada evaluación se reparte en las semanas anteriores a la entrega."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Planifier ma semaine place les séances dans ces créneaux, autour de vos cours, événements et examens. Le travail de chaque évaluation est réparti sur les semaines qui précèdent l’échéance."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "“规划本周”会把学习时段安排在这些时间，避开课程、日程和考试。每项考核的准备工作会分散到截止前的几周里。"
          }
        }
      }
    },
