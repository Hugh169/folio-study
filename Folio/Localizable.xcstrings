    "One week, or Week A and Week B. Folio shows your classes and notices files from a lesson." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Eine Woche oder Woche A und B. Folio zeigt deinen Unterricht und erkennt Dateien aus einer Stunde."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Una semana, o semanas A y B. Folio muestra tus clases y detecta los archivos de cada clase."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Une semaine, ou semaines A et B. Folio affiche vos cours et repère les fichiers d’une leçon."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "一周，或 A 周和 B 周。Folio 会显示你的课程，并识别课上的文件。"
          }
        }
      }
    },
    "Only when separate signals agree, such as the words in the file and the on-device AI." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nur wenn getrennte Hinweise übereinstimmen, etwa die Wörter in der Datei und die KI auf dem Gerät."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Solo cuando coinciden señales distintas, como las palabras del archivo y la IA del dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Seulement quand des indices distincts concordent, par exemple les mots du fichier et l’IA sur l’appareil."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "仅当不同的线索一致时，例如文件中的词语与设备端 AI 的判断。"
          }
        }
      }
