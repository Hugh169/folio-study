    },
    "Folio isn't allowed to use %@. You can change that in System Settings." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Folio darf %@ nicht verwenden. Du kannst das in den Systemeinstellungen ändern."
          }
