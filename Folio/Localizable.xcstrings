          }
        }
      }
    },
    "Each exam is named after its subject and this, such as “Biology Trial exams”." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jede Prüfung heißt wie ihr Fach und dies, z. B. „Biologie Probeprüfungen“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cada examen se llama como su asignatura más esto, p. ej., «Biología Exámenes de prueba»."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Chaque examen prend le nom de sa matière suivi de ceci, p. ex. « Biologie Examens blancs »."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "每场考试以科目名加上这个名称命名，例如“生物 模拟考试”。"
          }
        }
      }
    },
    "Each kind's name is also its folder's name. Folio looks for these words in a file's name and first lines." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Der Name jeder Art ist auch der Name ihres Ordners. Folio sucht diese Wörter im Namen und in den ersten Zeilen einer Datei."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "El nombre de cada tipo es también el de su carpeta. Folio busca estas palabras en el nombre y las primeras líneas de cada archivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le nom de chaque type est aussi celui de son dossier. Folio cherche ces mots dans le nom et les premières lignes d’un fichier."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "每种类型的名称也是其文件夹的名称。Folio 会在文件名和开头几行中查找这些词语。"
          }
        }
      }
    },
    "Each subject needs a name, and no two can share one." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jedes Fach braucht einen Namen, und keine zwei dürfen gleich heißen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cada asignatura necesita un nombre y no puede haber dos iguales."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Chaque matière doit avoir un nom, et deux matières ne peuvent pas porter le même."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "每个科目都需要名称，且不能重名。"
          }
        }
      }
    },
