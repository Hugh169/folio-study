    },
    "Folio is still reading your files. Try again in a minute." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Folio liest deine Dateien noch. Versuch es in einer Minute noch mal."
          }
        },
        "es" : {
          "stringUnit" : {
