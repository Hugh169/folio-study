    },
    "Darker bars are time studied; lighter ones, time planned. Shares compare your study with the work due in the next six weeks." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dunkle Balken zeigen die Lernzeit, helle die geplante Zeit. Die Anteile vergleichen deine Lernzeit mit der Arbeit, die in den nächsten sechs Wochen fällig ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Las barras oscuras son el tiempo estudiado y las claras, el previsto. Los porcentajes comparan tu estudio con el trabajo de las próximas seis semanas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les barres foncées montrent le temps révisé, les claires le temps prévu. Les parts comparent vos révisions au travail à rendre dans les six prochaines semaines."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "深色条表示已学习的时间，浅色条表示计划的时间。占比将你的学习时间与未来六周内要完成的任务进行比较。"
          }
        }
      }
    },
