          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Folio lit vos calendriers sur ce Mac sans jamais les modifier. Les séances de révision restent dans Folio."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
