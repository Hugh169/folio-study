          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Folio plant Lerneinheiten rund um deinen Unterricht und zu den Zeiten, in denen du gern lernst."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Folio 会围绕你的课程和你喜欢的学习时间来安排学习时段。"
          }
        }
      }
    },
    "It replaces Folio's settings and records on this Mac. Your files aren't moved or changed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
