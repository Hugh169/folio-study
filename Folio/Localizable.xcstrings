    "Works back from your assessments and exams, around school and your free time. Sessions you made or changed stay put." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Plant rückwärts von deinen Aufgaben und Prüfungen aus, um Schule und Freizeit herum. Einheiten, die du angelegt oder geändert hast, bleiben, wo sie sind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Parte de tus evaluaciones y exámenes, en torno a las clases y tu tiempo libre. Las sesiones que has creado o cambiado se quedan donde están."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Part de vos évaluations et examens, autour des cours et de votre temps libre. Les séances que vous avez créées ou modifiées restent en place."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "从你的考核和考试倒推安排，避开上课时间，利用空闲时间。你自己添加或修改过的时段不会被移动。"
          }
        }
      }
    },
