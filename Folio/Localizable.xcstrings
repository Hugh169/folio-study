    "Periods with classes. Leave out recess and lunch: Folio keeps the whole school day free, from the first bell to the last." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Stunden mit Unterricht. Lass Pausen und Mittag weg: Folio hält den ganzen Schultag frei, vom ersten bis zum letzten Klingeln."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Horas con clase. No incluyas el recreo ni la comida: Folio deja libre todo el día de clase, del primer timbre al último."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Créneaux avec cours. Omettez la récréation et le déjeuner : Folio garde toute la journée libre, de la première à la dernière sonnerie."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "有课的课节。不要包括课间和午饭：Folio 会把从第一遍铃到最后一遍铃的整个上学日都空出来。"
          }
        }
      }
    },
