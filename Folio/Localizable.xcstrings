        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Verwende {subject}, {type}, {year} und {exam} mit einem / zwischen den Ordnern. Ordner für Angaben, die Folio nicht findet, entfallen. Bereits abgelegte Dateien bleiben, wo sie sind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Usa {subject}, {type}, {year} y {exam}, con una / entre carpetas. Se omiten las carpetas de los datos que Folio no encuentra. Los archivos ya archivados se quedan donde están."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Utilisez {subject}, {type}, {year} et {exam}, avec une / entre les dossiers. Les dossiers des détails que Folio ne trouve pas sont omis. Les fichiers déjà classés restent à leur place."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
