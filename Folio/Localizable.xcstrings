    },
    "Folio can't reach your %@ any more. It may have been moved or renamed. Choose it again and Folio will carry on where it left off." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Folio erreicht deinen %@ nicht mehr. Vielleicht wurde er verschoben oder umbenannt. Wähle ihn erneut aus, dann macht Folio dort weiter, wo es aufgehört hat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Folio ya no puede acceder a tu %@. Puede que se haya movido o cambiado de nombre. Vuelve a elegirla y Folio seguirá donde lo dejó."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Folio ne peut plus accéder à votre %@. Il a peut-être été déplacé ou renommé. Choisissez-le de nouveau et Folio reprendra là où il s’était arrêté."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Folio 无法再访问你的%@。它可能已被移动或重新命名。请重新选取，Folio 会从上次中断的地方继续。"
          }
        }
      }
    },
