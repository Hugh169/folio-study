    "Folio doesn't make cards from task sheets or marking criteria, so it never writes answers for an assessment." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Folio erstellt keine Karten aus Aufgabenblättern oder Bewertungskriterien, damit es nie Antworten für eine Leistungsüberprüfung schreibt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Folio no crea tarjetas a partir de enunciados ni criterios de evaluación, así nunca escribe las respuestas de una evaluación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Folio ne crée pas de fiches à partir des consignes ou des critères de notation, pour ne jamais rédiger les réponses d’une évaluation."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Folio 不会用任务说明或评分标准制作卡片，因此绝不会替你写考核的答案。"
          }
        }
      }
    },
